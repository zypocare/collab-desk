{
	"name": "Miracle",
	"short_name": "Miracle",
	"description": "Brand collaborations: requests, quotes, content, invoices and results in one place.",
	"start_url": "/studio",
	"scope": "/",
	"display": "standalone",
	"background_color": "#110D11",
	"theme_color": "#1C1219",
	"icons": [
		{ "src": "/icon-192.png?v=4", "sizes": "192x192", "type": "image/png" },
		{ "src": "/icon-512.png?v=4", "sizes": "512x512", "type": "image/png" },
		{ "src": "/icon-maskable-512.png?v=4", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
		{ "src": "/icon.svg?v=4", "sizes": "any", "type": "image/svg+xml" }
	],
	"shortcuts": [
		{ "name": "New collab", "short_name": "New collab", "url": "/studio?new=1", "icons": [{ "src": "/icon-192.png?v=4", "sizes": "192x192", "type": "image/png" }] },
		{ "name": "Ask your desk", "short_name": "Ask desk", "url": "/studio?ask=1", "icons": [{ "src": "/icon-192.png?v=4", "sizes": "192x192", "type": "image/png" }] }
	],
	"share_target": {
		"action": "/studio/share",
		"method": "POST",
		"enctype": "multipart/form-data",
		"params": {
			"title": "title",
			"text": "text",
			"url": "url",
			"files": [{ "name": "shot", "accept": ["image/png", "image/jpeg", "image/webp", "image/*"] }]
		}
	}
}
