# Copy to .env and fill in. These values are public (they ship in the website).
# Supabase: Project Settings > API > Project URL and anon (public) key.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
# Cloudflare Turnstile site key (optional locally, required in production).
VITE_TURNSTILE_SITE_KEY=
# Instagram app ID (Meta app → Instagram → API setup with Instagram login). Optional until you connect Instagram.
VITE_INSTAGRAM_APP_ID=
