// Cloudflare deploys the built website (the "build" folder) as static files.
// Every address that isn't a file (like /studio/collabs) gets index.html, and the app handles it.
// /api/* goes to the small server in worker/index.ts first (the free AI); it uses Cloudflare's
// AI models through the "AI" binding, so there is no key to keep.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "collab-desk",
	"compatibility_date": "2026-10-01",
	"main": "./worker/index.ts",
	"assets": {
		"directory": "./build",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	"ai": { "binding": "AI" },
	// Public address of the database (the same one the website uses).
	"vars": { "SUPABASE_URL": "https://qzsfuvcxpqaavmwkxutt.supabase.co" }
}
