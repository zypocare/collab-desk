// Cloudflare deploys the built website (the "build" folder) as static files.
// Every address that isn't a file (like /studio/collabs) gets index.html, and the app handles it.
// /api/* goes to the small server in worker/index.ts first (the free AI); it uses Cloudflare's
// AI models through the "AI" binding, so there is no key to keep.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "collab-desk",
	"compatibility_date": "2026-10-01",
	"main": "./worker/index.ts",
	"assets": {
		"directory": "./build",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*", "/", "/q/*"]
	},
	"ai": { "binding": "AI" },
	// Niveditha's own address. Cloudflare makes the DNS record and the certificate on deploy; the old
	// workers.dev address keeps working alongside it.
	"routes": [{ "pattern": "nivy.miracleapp.live", "custom_domain": true }],
	// With routes set, Cloudflare turns the workers.dev address off unless this says otherwise.
	"workers_dev": true,
	// Keep variables added in the Cloudflare dashboard (like GEMINI_API_KEY) when the app redeploys.
	"keep_vars": true,
	// Public address of the database (the same one the website uses).
	// The public key (the same one inside the website); it only reaches what logged-out visitors can.
	"vars": { "SUPABASE_URL": "https://qzsfuvcxpqaavmwkxutt.supabase.co", "SUPABASE_ANON_KEY": "sb_publishable_UaW1ryl2S-gvm7worjrHJw_Hjr9k3wj" }
}
