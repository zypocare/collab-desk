{
  "cleanUrls": true,
  "redirects": [
    { "source": "/waitlist", "destination": "https://app.miracleapp.live/signup?as=creator", "permanent": false }
  ],
  "rewrites": [
    { "source": "/creators", "destination": "https://app.miracleapp.live/creators" },
    { "source": "/creators/:path*", "destination": "https://app.miracleapp.live/creators/:path*" }
  ]
}
