{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/waitlist",
      "destination": "https://app.miracleapp.live/signup?as=creator",
      "permanent": false
    },
    {
      "source": "/app",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*Android.*"
        }
      ],
      "destination": "https://play.google.com/store/apps/details?id=live.miracleapp.app",
      "permanent": false
    },
    {
      "source": "/app",
      "destination": "/#app",
      "permanent": false
    },
    {
      "source": "/android",
      "destination": "https://play.google.com/store/apps/details?id=live.miracleapp.app",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/creators",
      "destination": "https://app.miracleapp.live/creators"
    },
    {
      "source": "/creators/:path*",
      "destination": "https://app.miracleapp.live/creators/:path*"
    }
  ]
}
